/**
 * Catppuccin Mocha theme for rofi
 * Matched to waybar colors
 **/

configuration {
    modi:                "drun";
    show-icons:          true;
    display-drun:        "";
    drun-display-format: "{name}";
    icon-theme:          "Papirus-Dark";
}

* {
    font:            "JetBrains Mono Nerd Font 11";

    background:      #1e1e2e;
    background-alt:  #313244;
    foreground:      #cdd6f4;
    selected:        #b4befe;
    selected-fg:     #1e1e2e;
    muted:           #585b70;
    border-col:      #b4befe;
}

window {
    transparency:        "real";
    location:            center;
    anchor:              center;
    width:               560px;
    border:              2px solid;
    border-radius:       14px;
    border-color:        @border-col;
    background-color:    @background;
}

mainbox {
    spacing:             0px;
    background-color:    transparent;
    orientation:         vertical;
    children:            [ "inputbar", "listview" ];
}

inputbar {
    spacing:             10px;
    padding:             12px 16px;
    background-color:    @background-alt;
    border-radius:       12px 12px 0px 0px;
    text-color:          @foreground;
    children:            [ "entry" ];
}

entry {
    background-color:    transparent;
    text-color:          @foreground;
    cursor:              text;
    placeholder:         " Search apps...";
    placeholder-color:   @muted;
}

listview {
    padding:             8px;
    columns:             1;
    lines:               9;
    scrollbar:           false;
    spacing:             3px;
    fixed-height:        true;
    background-color:    @background;
    border-radius:       0px 0px 12px 12px;
}

element {
    padding:             8px 12px;
    spacing:             12px;
    border-radius:       8px;
    background-color:    transparent;
    text-color:          @foreground;
    cursor:              pointer;
    orientation:         horizontal;
    children:            [ "element-icon", "element-text" ];
}

element selected {
    background-color:    @selected;
    text-color:          @selected-fg;
}

element-icon {
    size:                26px;
    background-color:    transparent;
    text-color:          inherit;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    expand:              true;
    vertical-align:      0.5;
}
