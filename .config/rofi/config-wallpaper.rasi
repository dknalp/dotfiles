/**
 * Catppuccin Mocha — Wallpaper Picker
 * Grid layout, matches waybar + app launcher style
 **/

configuration {
    show-icons:     true;
    icon-theme:     "Papirus-Dark";
    display-drun:   "";
}

* {
    font:            "JetBrains Mono Nerd Font 11";

    background:      #1e1e2e;
    background-alt:  #313244;
    foreground:      #cdd6f4;
    selected:        #b4befe;
    selected-fg:     #1e1e2e;
    muted:           #585b70;
    border-col:      #b4befe;
}

window {
    transparency:        "real";
    location:            center;
    anchor:              center;
    width:               900px;
    border:              2px solid;
    border-radius:       14px;
    border-color:        @border-col;
    background-color:    @background;
}

mainbox {
    spacing:             0px;
    background-color:    transparent;
    orientation:         vertical;
    children:            [ "inputbar", "listview" ];
}

inputbar {
    spacing:             10px;
    padding:             12px 16px;
    background-color:    @background-alt;
    border-radius:       12px 12px 0px 0px;
    text-color:          @foreground;
    children:            [ "entry" ];
}

entry {
    background-color:    transparent;
    text-color:          @foreground;
    cursor:              text;
    placeholder:         "󰋩  Search wallpapers...";
    placeholder-color:   @muted;
}

listview {
    padding:             12px;
    columns:             4;
    lines:               3;
    scrollbar:           false;
    spacing:             8px;
    fixed-height:        true;
    background-color:    @background;
    border-radius:       0px 0px 12px 12px;
}

element {
    padding:             6px;
    spacing:             0px;
    border-radius:       8px;
    background-color:    transparent;
    text-color:          @foreground;
    cursor:              pointer;
    orientation:         vertical;
    children:            [ "element-icon", "element-text" ];
}

element normal.normal {
    background-color:    transparent;
    text-color:          @foreground;
}

element selected.normal {
    background-color:    @selected;
    text-color:          @selected-fg;
    border-radius:       8px;
}

element-icon {
    size:                100%;
    border-radius:       6px;
    cursor:              inherit;
    background-color:    transparent;
}

element-text {
    padding:             4px 2px 2px 2px;
    background-color:    transparent;
    text-color:          inherit;
    cursor:              inherit;
    highlight:           bold;
    font:                "JetBrains Mono Nerd Font 9";
}
