/**
 * Clipboard History — Catppuccin Mocha
 * Matches app launcher + cheatsheet style
 **/

* {
    font:            "JetBrains Mono Nerd Font 11";
    background:      #1e1e2e;
    background-alt:  #313244;
    foreground:      #cdd6f4;
    selected:        #b4befe;
    selected-fg:     #1e1e2e;
    muted:           #585b70;
    border-col:      #b4befe;
}

window {
    transparency:        "real";
    location:            center;
    anchor:              center;
    width:               620px;
    border:              2px solid;
    border-radius:       14px;
    border-color:        @border-col;
    background-color:    @background;
}

mainbox {
    spacing:             0px;
    background-color:    transparent;
    orientation:         vertical;
    children:            [ "inputbar", "listview" ];
}

inputbar {
    spacing:             10px;
    padding:             10px 16px;
    background-color:    @background-alt;
    border-radius:       12px 12px 0px 0px;
    text-color:          @foreground;
    children:            [ "prompt", "entry" ];
}

prompt {
    background-color:    transparent;
    text-color:          @selected;
}

entry {
    background-color:    transparent;
    text-color:          @foreground;
    cursor:              text;
    placeholder:         "Search clipboard...";
    placeholder-color:   @muted;
}

listview {
    padding:             8px;
    columns:             1;
    lines:               10;
    scrollbar:           false;
    spacing:             3px;
    fixed-height:        true;
    background-color:    @background;
    border-radius:       0px 0px 12px 12px;
}

element {
    padding:             8px 14px;
    border-radius:       6px;
    background-color:    transparent;
    text-color:          @foreground;
    cursor:              pointer;
    orientation:         horizontal;
    children:            [ "element-text" ];
}

element normal.normal {
    background-color:    transparent;
    text-color:          @foreground;
}

element selected.normal {
    background-color:    @selected;
    text-color:          @selected-fg;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    cursor:              inherit;
    highlight:           bold italic;
}
</content>
